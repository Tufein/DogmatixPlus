<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name="com.tufein.valkyr.JournalDocumentPickerActivity" android:exported="true" android:theme="@android:style/Theme.NoDisplay" />
        <provider android:name="com.tufein.valkyr.JournalAttachmentTestProvider" android:authorities="com.tufein.valkyr.test.journal" android:exported="true" android:grantUriPermissions="true">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
        <provider android:name="com.tufein.valkyr.TestStorageProvider" android:authorities="com.tufein.valkyr.test.storage" android:exported="true" android:grantUriPermissions="true">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
        <activity android:name="com.tufein.valkyr.PlayGrantProbeActivity" android:exported="true" android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
                <data android:scheme="content" android:mimeType="application/zip" />
            </intent-filter>
        </activity>
    </application>
</manifest>
