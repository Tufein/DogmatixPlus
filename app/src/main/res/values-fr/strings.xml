    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Bienvenue dans Dogmatix</string>
    <string name="onboarding_welcome_body">Dogmatix indexe le contenu de sources de ROM — torrents, magnets et répertoires web —, classe chaque fichier par console, région et langue, et vous permet de parcourir, filtrer et télécharger directement dans votre dossier de ROM. Les archives sont extraites automatiquement.</string>
    <string name="onboarding_welcome_point_1">Les sources sont indexées, pas téléchargées : parcourez des milliers de titres sans remplir votre stockage.</string>
    <string name="onboarding_welcome_point_2">Filtrez par console, région, langue, tag et source ; ✓ marque ce que vous possédez déjà.</string>
    <string name="onboarding_welcome_point_3">Les téléchargements arrivent dans un dossier par console, prêts pour des frontends comme ES-DE.</string>
    <string name="onboarding_folder_title">Où sont vos ROM ?</string>
    <string name="onboarding_folder_body">Choisissez le dossier racine de votre bibliothèque de ROM. Chaque console y reçoit son propre sous-dossier (ceux qui existent comme « gba » ou « psx » sont réutilisés). Vous pourrez le changer plus tard dans les Paramètres.</string>
    <string name="onboarding_folder_current">Dossier : %1$s</string>
    <string name="onboarding_folder_choose">Choisir un dossier</string>
    <string name="onboarding_folder_change">Changer de dossier</string>
    <string name="onboarding_sources_title">Ajoutez vos sources</string>
    <string name="onboarding_sources_body">Dogmatix est livré sans sources. Importez un JSON de sources (par exemple celui partagé depuis un autre appareil) et chaque console qu’il contient sera indexée aussitôt. Vous pourrez aussi ajouter des consoles et des URL à la main dans l’onglet Sources.</string>
    <string name="onboarding_sources_import">Importer un JSON</string>
