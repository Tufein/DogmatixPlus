<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules (Android 12 and newer). The cloud backup passphrase and this device's id stay on the device. -->
<!-- The "Set up a new handheld" progress (new_handheld) belongs to this handheld only, too. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/dav_device.preferences_pb"/>
        <exclude domain="file" path="datastore/new_handheld.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/dav_device.preferences_pb"/>
        <exclude domain="file" path="datastore/new_handheld.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
