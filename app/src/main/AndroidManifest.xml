<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 8.0: also installable on Android TV / Google TV boxes, which have no touchscreen. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Background save sync: the periodic job survives a reboot and tells about conflicts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- In-app update (Settings → Check for updates): hands the downloaded release APK to the installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- "Configure ES-DE" / "Configure iiSU" read the frontend's bundled defaults from its
         installed APK; without these entries Android 11+ package visibility hides the app and
         the setups wrongly report "not installed". -->
    <queries>
        <intent><action android:name="android.intent.action.VIEW" /><data android:mimeType="application/octet-stream" /></intent>
        <package android:name="org.es_de.frontend" />
        <package android:name="com.iisulauncher" />
    </queries>

    <application
        android:name=".DogmatixApplication"
        android:allowBackup="true"
        android:largeHeap="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Dogmatix">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Dogmatix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Links shared to the app (2.5): a URL or magnet in shared text, or a magnet link opened here. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>
            <!-- Deep links: dogmatix://library?console=…&region=…&q=…&fav=1 (see util/DeepLinkParser). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dogmatix" android:host="library" />
            </intent-filter>
            <!-- .dgmtx shortcut files (frontends like ES-DE, file managers): the deep link is
                 inside the file (see util/DgmtxFile). The repeated patterns work around
                 PatternMatcher's non-greedy ".*", which stops at the first dot in the path.
                 android:host is required even though any authority is fine: IntentFilter only
                 checks the paths inside its authority branch, so without a host every
                 content:// file of any type matched and Dogmatix was offered to open APKs.
                 The mime types are the ones providers report for an unknown extension; they
                 keep APKs out even when the URI hides the file name. Frontends launch us with
                 an explicit component, so they never go through this filter. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/plain" />
                <data android:pathPattern=".*\\.dgmtx" />
                <data android:pathPattern=".*\\..*\\.dgmtx" />
                <data android:pathPattern=".*\\..*\\..*\\.dgmtx" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.dgmtx" />
            </intent-filter>
        </activity>
        <!-- "Add a shortcut" picker for launchers and frontends (Cocoon, …). -->
        <activity
            android:name=".ui.shortcut.CreateShortcutActivity"
            android:exported="true"
            android:label="@string/shortcut_pick_label"
            android:theme="@style/Theme.Dogmatix">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <service
            android:name=".data.service.DownloadForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".data.service.SaveSyncJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".data.service.AutoBackupJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".data.service.AutoScanJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name=".data.service.UpdateInstallReceiver"
            android:exported="false" />
        <!-- Home-screen widget: downloads in progress and games recent rescans found (widget/WidgetUpdater). -->
        <receiver
            android:name=".widget.DogmatixWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Persists the language chosen in Settings across launches (AppCompatDelegate.setApplicationLocales). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    
        <receiver
            android:name=".widget.ContinueWidget"
            android:exported="false"
            android:label="@string/share6_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_continue_info" />
        </receiver>
    
        <service
            android:name=".data.service.QueueTileService"
            android:exported="true"
            android:icon="@drawable/ic_download"
            android:label="@string/quick7_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".data.service.WeeklyDigestJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".data.service.SmartStorageJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name=".data.service.NotificationActionReceiver"
            android:exported="false" />
    </application>

</manifest>
